# Local Postgres (Homebrew) — swap for a Neon connection string when deploying
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5432/portfolio"

# Auth.js
AUTH_SECRET="generate-with-npx-auth-secret"

# Seeded admin login (used by prisma/seed.ts)
ADMIN_EMAIL="miguelcq13@gmail.com"
ADMIN_PASSWORD="change-me-locally"

# Resend (email notifications for booking requests, contact leads, and new
# reviews) — leave empty locally to skip sending; everything still saves to
# the database and shows up in the admin panel. Notifications go to the
# "Email de contacto" set in /admin/settings, falling back to ADMIN_EMAIL.
# RESEND_FROM_EMAIL must be on a domain verified in your Resend account for
# production; onboarding@resend.dev only works for sending to your own
# Resend account email.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Vercel Blob (admin media uploads — logos, photos, hero video, etc.) — leave
# empty locally to disable uploads; the URL field still works with pasted links.
BLOB_READ_WRITE_TOKEN=""

# Absolute site URL used to build links inside emails (proposal links,
# checkout redirect URLs). On Vercel this falls back to VERCEL_URL
# automatically; set this explicitly if you're on a custom domain.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Stripe (deposit payments on accepted proposals) — leave empty locally to
# disable online payment; the proposal page still works, just shows "contact
# me to arrange payment" instead of a Pagar button. STRIPE_WEBHOOK_SECRET is
# the signing secret for the /api/webhooks/stripe endpoint (from the Stripe
# dashboard → Webhooks, after adding that URL).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
