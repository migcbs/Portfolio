generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
}

model LegalPage {
  id        String   @id // "terms" | "privacy"
  title     String
  content   String
  updatedAt DateTime @updatedAt
}

model SiteSettings {
  id              String   @id @default("singleton")
  portfolioBrand  String   @default("Miguel Ceballos — Portafolio")
  agencyBrand     String   @default("ATENU BrandHouse")
  heroTitle       String   @default("Step Through. Work Smarter.")
  heroDescription String   @default("Desarrollo web y soluciones digitales para tu marca.")
  heroVideoUrl    String?
  heroImageUrl    String?
  aboutText       String   @default("")
  aboutImageUrl   String?
  contactEmail    String   @default("")
  agencyTagline   String   @default("Agencia de marketing digital.")
  agencyServices  String[] @default(["Fotografía", "Video", "Diseño gráfico", "Impresiones", "Merch"])
  atenuIntro      String   @default("Ayudamos a marcas a verse y sonar como se sienten: fotografía, video, diseño e impresión bajo un mismo equipo.")
  atenuCustomText String   @default("¿Tu negocio necesita algo distinto? También armamos soluciones a la medida, fuera de estos paquetes.")
  logoUrl         String?
  backgroundUrl   String?
  meetingDurationMinutes Int @default(30)
  updatedAt       DateTime @updatedAt
}

model Client {
  id          String       @id @default(cuid())
  name        String
  description String?
  logoUrl     String?
  website     String?
  active      Boolean      @default(true)
  order       Int          @default(0)
  stories     Story[]
  socialLinks SocialLink[]
  createdAt   DateTime     @default(now())
}

enum StoryType {
  IMAGE
  VIDEO
}

enum StoryCategory {
  PHOTO
  VIDEO
  MERCH
}

model Story {
  id        String        @id @default(cuid())
  clientId  String
  client    Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  category  StoryCategory @default(PHOTO)
  type      StoryType     @default(IMAGE)
  mediaUrl  String
  order     Int           @default(0)
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
}

enum ProjectCategory {
  WEB_DEV
  DIGITAL_MARKETING
  PHOTO
  VIDEO
  GRAPHIC_DESIGN
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
}

enum ProjectType {
  LANDING
  CORPORATE
  ECOMMERCE
  SAAS
  WEBAPP
  CUSTOM
}

enum TaskPhase {
  DESIGN
  DEVELOPMENT
  CLIENT_REVIEW
  QA
  DELIVERY
}

model ProjectTask {
  id        String           @id @default(cuid())
  projectId String
  project   PortfolioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase     TaskPhase
  label     String
  done      Boolean          @default(false)
  order     Int              @default(0)
  createdAt DateTime         @default(now())
}

model ProjectMedia {
  id        String           @id @default(cuid())
  projectId String
  project   PortfolioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category  StoryCategory    @default(PHOTO)
  type      StoryType        @default(IMAGE)
  mediaUrl  String
  order     Int              @default(0)
  createdAt DateTime         @default(now())
}

model PortfolioProject {
  id            String          @id @default(cuid())
  title         String
  description   String
  imageUrl      String?
  projectUrl    String?
  tags          String[]
  category      ProjectCategory @default(WEB_DEV)
  projectType   ProjectType?
  status        ProjectStatus   @default(COMPLETED)
  progress      Int             @default(100)
  devTime       String?
  internalNotes String?
  tasks         ProjectTask[]
  media         ProjectMedia[]
  socialLinks   SocialLink[]
  order         Int             @default(0)
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())
}

enum ServiceScope {
  PERSONAL
  AGENCY
}

model Service {
  id          String       @id @default(cuid())
  name        String
  description String
  price       Decimal?     @db.Decimal(10, 2)
  features    String[]
  scope       ServiceScope @default(PERSONAL)
  order       Int          @default(0)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
}

model Review {
  id         String   @id @default(cuid())
  authorName String
  text       String
  rating     Int      @default(5)
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

enum LeadProjectType {
  WEB_DEV
  DIGITAL_MARKETING
}

enum LeadMarketingFocus {
  DESIGN
  PHOTO_VIDEO
}

enum PipelineStage {
  NEW
  CONTACTED
  QUOTE_SENT
  WON
  LOST
}

model Lead {
  id                String              @id @default(cuid())
  name              String
  email             String
  message           String
  interestedPackage String?
  projectType       LeadProjectType?
  marketingFocus    LeadMarketingFocus?
  read              Boolean             @default(false)
  stage             PipelineStage       @default(NEW)
  followUpAt        DateTime?
  notes             LeadNote[]
  proposals         Proposal[]
  createdAt         DateTime            @default(now())
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())
}

enum PreferredContact {
  EMAIL
  PHONE
  WHATSAPP
}

model BookingRequest {
  id               String           @id @default(cuid())
  name             String
  company          String?
  email            String
  phone            String?
  preferredContact PreferredContact @default(EMAIL)
  message          String?
  source           String
  read             Boolean          @default(false)
  stage            PipelineStage    @default(NEW)
  followUpAt       DateTime?
  scheduledAt      DateTime?
  notes            BookingNote[]
  proposals        Proposal[]
  createdAt        DateTime         @default(now())
}

model BookingNote {
  id               String         @id @default(cuid())
  bookingRequestId String
  bookingRequest   BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)
  text             String
  createdAt        DateTime       @default(now())
}

// Weekly recurring availability for scheduling meetings. Times are wall-clock
// "HH:mm" in America/Mexico_City — mainland Mexico has used a fixed UTC-6
// offset with no DST since 2022, so this can be a plain constant rather than
// needing a timezone library.
model Availability {
  id        String  @id @default(cuid())
  dayOfWeek Int
  startTime String
  endTime   String
  active    Boolean @default(true)
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
}

model Proposal {
  id                String          @id @default(cuid())
  token             String          @unique @default(cuid())
  leadId            String?
  lead              Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  bookingRequestId  String?
  bookingRequest    BookingRequest? @relation(fields: [bookingRequestId], references: [id], onDelete: SetNull)
  clientName        String
  clientEmail       String
  title             String
  description       String?
  items             ProposalItem[]
  depositPercent    Int             @default(50)
  validUntil        DateTime?
  status            ProposalStatus  @default(DRAFT)
  signedByName      String?
  signedAt          DateTime?
  signedIp          String?
  depositPaidAt     DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model ProposalItem {
  id         String   @id @default(cuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  label      String
  price      Decimal  @db.Decimal(10, 2)
  order      Int      @default(0)
}

enum SocialScope {
  PERSONAL
  AGENCY
}

model SocialLink {
  id        String            @id @default(cuid())
  label     String
  url       String
  scope     SocialScope       @default(PERSONAL)
  clientId  String?
  client    Client?           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId String?
  project   PortfolioProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order     Int               @default(0)
  createdAt DateTime          @default(now())
}
